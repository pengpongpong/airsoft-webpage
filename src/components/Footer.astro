---
const currentYear = new Date().getFullYear();
---

<footer class="footer">
  <div class="container">
    <div class="footer-content">
      <p class="footer-text">© {currentYear} Airsoft Panthers Graz. Alle Rechte vorbehalten.</p>
      <nav class="footer-nav" aria-label="Fußzeilen-Navigation">
        <a href="/info">Info</a>
        <a href="/events">Events</a>
        <a href="/photos">Fotos</a>
        <a href="/about">Über uns</a>
        <a href="/verein">Verein</a>
        <a href="/contact">Kontakt</a>
      </nav>
    </div>
  </div>
</footer>

<style>
  .footer {
    margin-top: auto;
    padding: 2rem 0;
    border-top: 1px solid var(--color-border);
  }

  .footer-content {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
  }

  .footer-text {
    margin: 0;
    color: var(--color-text-muted);
    font-size: 0.875rem;
  }

  .footer-nav {
    display: flex;
    gap: 1.5rem;
  }

  .footer-nav a {
    color: var(--color-text-muted);
    font-size: 0.875rem;
  }

  .footer-nav a:hover {
    color: var(--color-accent);
  }

  @media (max-width: 768px) {
    .footer {
      padding: 1.5rem 0;
    }

    .footer-content {
      flex-direction: column-reverse;
      justify-content: center;
      text-align: center;
      gap: 1.25rem;
    }

    .footer-nav {
      flex-wrap: wrap;
      justify-content: center;
      gap: 0.75rem 1.25rem;
    }

    .footer-text {
      font-size: 0.8rem;
    }
  }
</style>
